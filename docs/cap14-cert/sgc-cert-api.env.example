# sgc-cert-api (Vercel project, root apps/api, branch cap14-cert)
# PLACEHOLDERS ONLY. Every value must be a NEW certification value; never
# copy a production value. Set these in the Vercel project (Production
# environment of the cert project), never in git.

NODE_ENV=production
# Developer API keys issued here start with sg_test_ and work only here.
API_ENVIRONMENT=test

# UNIQUE certification values (never the production ones):
# - MONGODB_URI: database name must contain cap14_cert; a DB user scoped
#   (readWrite) to that database only.
MONGODB_URI=mongodb+srv://<cert-user>:<cert-password>@<cluster-host>/sgcommerce_cap14_cert?retryWrites=true&w=majority
# - REDIS_URL: a separate Redis database (the API has no key prefix support).
REDIS_URL=rediss://default:<cert-redis-password>@<cert-redis-host>:<port>
# - AUTH_SECRET: a new random secret (>= 32 random bytes).
AUTH_SECRET=<new-random-cert-secret>

CORS_ALLOWED_ORIGINS=https://<sgc-cert-storefront-domain>,https://<sgc-cert-admin-domain>
ENABLE_HSTS=true
# main.ts accepts '1' (the docs' "true" does not enable it).
TRUST_PROXY=1
STOREFRONT_URL=https://<sgc-cert-storefront-domain>

# DELIBERATELY ABSENT (online payment stays unavailable; cash on delivery only):
#   SSLCOMMERZ_STORE_ID, SSLCOMMERZ_STORE_PASSWORD, SSLCOMMERZ_LIVE
# No courier integration exists in SGCommerce.
