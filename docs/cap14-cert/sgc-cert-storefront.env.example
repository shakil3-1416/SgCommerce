# sgc-cert-storefront (Vercel project, root apps/storefront, branch cap14-cert)
# PLACEHOLDERS ONLY.
NEXT_PUBLIC_API_URL=https://<sgc-cert-api-domain>/api/v1
INTERNAL_API_URL=https://<sgc-cert-api-domain>/api/v1
CUSTOMER_COOKIE_SECURE=true
# SupGent Web Chat (public values; override supgent-widget.config.json).
# NEXT_PUBLIC_* are build-time: redeploy after changing them.
NEXT_PUBLIC_SUPGENT_WIDGET_URL=https://<supgent-widget-host>/supgent-widget.js
NEXT_PUBLIC_SUPGENT_WIDGET_CHANNEL=wc_<dedicated-cap14-installation>
NEXT_PUBLIC_SUPGENT_API_BASE=https://<supgent-api-host>
