# sgc-cert-admin (Vercel project, root apps/admin, branch cap14-cert)
# PLACEHOLDERS ONLY.
API_URL=https://<sgc-cert-api-domain>/api/v1
NEXT_PUBLIC_API_URL=https://<sgc-cert-api-domain>/api/v1
ADMIN_COOKIE_SECURE=true
# Do NOT connect the production Blob store. Leave image upload unconfigured,
# or connect a separate cert Blob store (Vercel then adds BLOB_STORE_ID).
# BLOB_STORE_ID=<cert-blob-store-id>
# The admin login is created only in the cert database:
#   MONGODB_URI=<cert MONGODB_URI> pnpm --filter api seed:admin
