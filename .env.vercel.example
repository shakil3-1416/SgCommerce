# ============================================================
# SGCOMMERCE VERCEL ENVIRONMENT CONTRACT
# Do not put real secrets in this file.
# ============================================================

# API PROJECT: apps/api
NODE_ENV=production
AUTH_SECRET=replace-with-at-least-32-random-characters
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/sgcommerce
REDIS_URL=rediss://USER:PASSWORD@REDIS-HOST:PORT
CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com
ENABLE_HSTS=true
TRUST_PROXY=true

# Online payment through SSLCOMMERZ (optional). Without the first three,
# the shop offers cash on delivery only. See docs/PAYMENTS_SSLCOMMERZ.md.
SSLCOMMERZ_STORE_ID=replace_me
SSLCOMMERZ_STORE_PASSWORD=replace_me
STOREFRONT_URL=https://shop.example.com
# Leave unset for the sandbox (test payments). Set to true only with a
# live store ID and password.
# SSLCOMMERZ_LIVE=true

# Developer API. Leave unset on the real shop: keys are then sg_live_.
# Set to test only on a separate sandbox deployment with its own
# database; keys issued there are sg_test_ and work only there.
# API_ENVIRONMENT=test

# STOREFRONT PROJECT: apps/storefront
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
INTERNAL_API_URL=https://api.example.com/api/v1
CUSTOMER_COOKIE_SECURE=true

# ADMIN PROJECT: apps/admin
API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
ADMIN_COOKIE_SECURE=true

# Product image uploads. Vercel adds this to the admin project by itself
# when a public Blob store is connected to it (Storage -> the store ->
# Connect Project). No storage token is needed on Vercel.
BLOB_STORE_ID=store_replace_me
