# ============================================================
# SGCOMMERCE VERCEL ENVIRONMENT CONTRACT
# Do not put real secrets in this file.
# ============================================================

# API PROJECT: apps/api
NODE_ENV=production
AUTH_SECRET=replace-with-at-least-32-random-characters
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/sgcommerce
REDIS_URL=rediss://USER:PASSWORD@REDIS-HOST:PORT
CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com
ENABLE_HSTS=true
TRUST_PROXY=true

# STOREFRONT PROJECT: apps/storefront
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
INTERNAL_API_URL=https://api.example.com/api/v1
CUSTOMER_COOKIE_SECURE=true

# ADMIN PROJECT: apps/admin
API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
ADMIN_COOKIE_SECURE=true
