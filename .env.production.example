NODE_ENV=production

# Generate:
# openssl rand -hex 64
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

SG_ADMIN_EMAIL=merchant@example.com
SG_ADMIN_PHONE=01700000000
SG_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# Public URL available to customer browsers.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Comma-separated trusted browser origins.
CORS_ALLOWED_ORIGINS=https://shop.example.com,https://admin.example.com

# Keep true when deployed behind HTTPS.
ADMIN_COOKIE_SECURE=true
