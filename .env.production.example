NODE_ENV=production

# Required. Generate a long random value:
# openssl rand -hex 64
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Initial merchant administrator.
SG_ADMIN_EMAIL=admin@example.com
SG_ADMIN_PHONE=01700000000
SG_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# Public API used by browser applications.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1

# Server-side API endpoint used by Admin.
API_URL=https://api.example.com/api/v1

# Database / Redis variable names should match the existing API configuration.
# Inspect apps/api/src/app.module.ts before deployment and set them in the
# deployment environment rather than committing secrets.
